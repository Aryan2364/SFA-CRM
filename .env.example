# Copy to .env.local — never commit .env.local

# PostgreSQL. Every variable here is server-only and read at RUNTIME.
# Never prefix any of these with NEXT_PUBLIC_ — that inlines the value into the
# browser bundle at build time.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sfacrm?sslmode=require&connection_limit=5

# CA certificate for the database connection. Required whenever the URL above
# carries sslmode -- the app fails closed rather than connecting unverified.
#
# Against a LOCAL PostgreSQL with no sslmode (the scratch database used by the
# write-path suites) TLS is not used at all and this can stay unset.
#
# Against AWS RDS outside the Docker image, point this at the committed bundle.
# DATABASE_CA_CERT_PATH=certs/rds-global-bundle.pem

# Session secret (server-only). Also keys the receipt-photo tags, so rotating it
# fails only a receipt uploaded before the rotation and submitted after it.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional. How long a login lasts, in days (default 7). Server-only.
# SESSION_MAX_AGE_DAYS=7

# Optional. Login lifetime in days when signing in from a phone (default 30). Server-only.
# PHONE_SESSION_MAX_AGE_DAYS=30

# Optional. The business calendar used for "today" and day boundaries
# (attendance, meetings, expenses, points, auto-checkout). Production servers
# run UTC; this keeps the day aligned with the users' clock. Server-only.
# APP_TIMEZONE=Asia/Kolkata

# Default tenant (fixed UUID for single-tenant dev). Note the public auth routes
# (forgot-password / reset-password) fall back to this tenant — see PLAN.md 13.2.
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Cloudflare R2 — expense receipts. Private bucket, signed URLs only.
# R2_ENDPOINT is account-level and must NOT include the bucket name.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=sfacrm
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public base URL of this deployment, e.g. https://admin.example.com. Used to
# build password-reset links; never derived from the request Host header (a
# forged Host would email the victim a link to the attacker's domain). Required
# in production — password reset returns 503 without it.
APP_URL=

# Outbound email (password reset, notifications). Required in production —
# password reset returns 503 when SMTP_HOST or SMTP_USER is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Phone push notifications. Generate the pair once with: npx web-push generate-vapid-keys
# Server-only; never NEXT_PUBLIC_. Empty = push is off (the in-app bell still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rgbindia.com
# Bearer secret for POST /api/cron/follow-up-reminders (host crontab). Unset = the route answers 401.
CRON_SECRET=

# ---------------------------------------------------------------------------
# LOCAL ONLY — never set in production
#
# Scratch PostgreSQL for the write-path test suites. They refuse to run against
# any non-localhost host.
SCRATCH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sfacrm_local
#
# Tenant-scope audit query log. Appends every SQL statement to a file, unbounded.
# PRISMA_QUERY_LOG=.audit/query-log.jsonl
# ---------------------------------------------------------------------------

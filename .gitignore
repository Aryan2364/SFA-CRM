# dependencies
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# ...but the RDS CA bundle is COMMITTED on purpose. It is a public certificate
# (nothing secret), and the app now refuses to start in production without it,
# so it must be in the image. The blanket *.pem above would otherwise swallow it
# silently -- which it did on the first attempt. See src/lib/db.ts.
!certs/rds-global-bundle.pem

# Supabase's CA is NOT committed. It is a per-project download from the
# dashboard (Settings -> Database -> SSL configuration) and is only needed for
# development against Supabase, which this app is migrating off.
certs/supabase-*.crt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma generated client (regenerated by `prisma generate` at build time)
/src/generated/prisma
/node_modules/.prisma

# transient output of `npm run verify:data-layer`
/.verify-build

# tenant-scope audit query log (transient)
/.audit

# python bytecode from scripts/migrate
__pycache__/
*.pyc

# Dev-server output from scripts/dev-local.mjs, and agent scratch dirs.
# Both are local run artefacts: they say what one machine did for a few
# minutes, never what the code is, so committing them only creates conflicts.
devserver.log
*.log
/.t9/

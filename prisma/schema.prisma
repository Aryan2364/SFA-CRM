/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model business_partners {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String              @db.Uuid
  type                    String
  name                    String
  distributor_id          String?             @db.Uuid
  mobile_1                String?
  address                 String?
  description             String?
  state_id                String?             @db.Uuid
  district_id             String?             @db.Uuid
  taluka_id               String?             @db.Uuid
  village_id              String?             @db.Uuid
  latitude                Decimal?            @db.Decimal(10, 7)
  longitude               Decimal?            @db.Decimal(10, 7)
  is_active               Boolean             @default(true)
  created_at              DateTime            @default(now()) @db.Timestamptz(6)
  updated_at              DateTime            @default(now()) @db.Timestamptz(6)
  mobile_2                String?
  contact_person_name     String?
  pincode                 String?
  gst_number              String?
  sub_type                String?
  stage                   String              @default("Existing")
  temperature             String?
  next_follow_up_date     DateTime?           @db.Date
  created_by_user_id      String?             @db.Uuid
  users                   users?              @relation(fields: [created_by_user_id], references: [id], onUpdate: NoAction)
  business_partners       business_partners?  @relation("business_partnersTobusiness_partners", fields: [distributor_id], references: [id], onUpdate: NoAction)
  other_business_partners business_partners[] @relation("business_partnersTobusiness_partners")
  districts               districts?          @relation(fields: [district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  states                  states?             @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  talukas                 talukas?            @relation(fields: [taluka_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  villages                villages?           @relation(fields: [village_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}


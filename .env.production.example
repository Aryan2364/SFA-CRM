# Copy to .env.production ON THE SERVER, next to docker-compose.deploy.yml.
# Never commit the real .env.production.
#
# These are read at RUNTIME by the container. Nothing here is baked into the
# image, so changing a value only needs a restart, not a rebuild.

# PostgreSQL (AWS RDS). sslmode=require is stripped before the pg driver sees it
# and re-applied as a TLS option; connection_limit is passed to the pg pool as
# `max`. Keep it at 5 — the instance is a db.t4g.micro shared by four
# applications and the binding constraint is RAM, not connection count.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&connection_limit=5

# Session secret (server-only) — long random string, at least 32 chars
SESSION_SECRET=

# Default tenant
DEFAULT_TENANT_ID=

# Bootstrap super admin
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# Outbound email (password reset, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudflare R2 — expense receipts. The bucket is PRIVATE and is read through
# short-lived signed URLs; never enable r2.dev or bind a public domain to it.
#
# R2_ENDPOINT is ACCOUNT-level and must NOT include the bucket name — the S3
# client sends the bucket separately, so including it doubles the path and 404s.
R2_ACCOUNT_ID=f54b41cb2e053dda20acdd4cfe91b996
R2_ENDPOINT=https://f54b41cb2e053dda20acdd4cfe91b996.r2.cloudflarestorage.com
R2_BUCKET=sfacrm
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# DO NOT SET IN PRODUCTION
#
# PRISMA_QUERY_LOG=<path> makes every emitted SQL statement append to that file,
# unbounded. It exists only for the tenant-scope audit (PLAN.md 8.2) and must
# never be set on a deployed instance.
#
# The Supabase variables are gone: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are no longer read
# by anything. Removing the last of them from the Dockerfile is part of the
# teardown in PLAN.md 9.
# ---------------------------------------------------------------------------

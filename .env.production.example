# Copy to .env.production ON THE SERVER, next to docker-compose.deploy.yml.
# Never commit the real .env.production.
#
# These are read at RUNTIME by the container. Nothing here is baked into the
# image, so changing a value only needs a restart, not a rebuild.

# Supabase service role key (server-only — bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Session secret (server-only) — long random string, at least 32 chars
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Default tenant
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Bootstrap super admin
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# Outbound email (password reset, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Database / Supabase URL (read at runtime)
SUPABASE_URL=https://your-project.supabase.co

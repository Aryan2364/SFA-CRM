# Never ship host node_modules — it clobbers the image's clean install and can
# carry wrong-arch native binaries (@next/swc, etc.).
node_modules
.next
out

# VCS / local tooling
.git
.gitignore
.vscode
.idea
.claude

# Local env & logs (provided at build/runtime, not baked into the image)
.env
.env.*
npm-debug.log*
*.log
*.tsbuildinfo

# Docker meta
Dockerfile
.dockerignore
docker-compose*.yml
deploy.sh

# The Supabase CA is a DEVELOPMENT-only trust anchor (gitignored, downloaded
# per-project from the dashboard). It must not travel into the production image.
# The RDS bundle in certs/ is copied deliberately -- see Dockerfile.
certs/supabase-*.crt

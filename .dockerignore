# Never ship host node_modules — it clobbers the image's clean install and can
# carry wrong-arch native binaries (@next/swc, etc.).
node_modules
.next
out

# VCS / local tooling
.git
.gitignore
.vscode
.idea
.claude

# Local env & logs (provided at build/runtime, not baked into the image)
.env
.env.*
npm-debug.log*
*.log
*.tsbuildinfo

# Docker meta
Dockerfile
.dockerignore
docker-compose*.yml
deploy.sh

# Documentation stays in git but never enters the build context, so no stage of
# the image can carry it. Nothing reads a .md at build time or runtime.
*.md
**/*.md

{
  "name": "rgb-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:sync": "prisma db pull && prisma generate && node scripts/generate-date-only-fields.mjs",
    "verify:data-layer": "tsc src/lib/db.ts --outDir .verify-build --module commonjs --target es2022 --moduleResolution node --skipLibCheck --esModuleInterop && node scripts/verify-data-layer.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "audit:tenant": "node scripts/audit-tenant-scope.mjs",
    "scratch:push": "prisma db push --schema prisma/schema.prisma --skip-generate --accept-data-loss",
    "scratch:seed": "node scripts/seed-scratch.mjs",
    "dev:scratch": "next dev -p 3012",
    "test:write": "node scripts/seed-scratch.mjs && node scripts/write-path-tests.mjs",
    "test:write:plans": "node scripts/seed-scratch.mjs && node scripts/write-path-weekly-plans.mjs",
    "test:write:ops": "node scripts/seed-scratch.mjs && node scripts/write-path-weekly-plans.mjs && node scripts/write-path-ops.mjs",
    "test:write:activity": "node scripts/seed-scratch.mjs && node scripts/write-path-activity.mjs",
    "verify:r2": "node scripts/seed-scratch.mjs && node scripts/verify-r2.mjs",
    "verify:session": "node --experimental-strip-types scripts/verify-session-formats.mjs",
    "verify:singleton": "tsc src/lib/db.ts --outDir .verify-build --module commonjs --target es2022 --moduleResolution node --skipLibCheck --esModuleInterop && node scripts/verify-prisma-singleton.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/nodemailer": "^7.0.11",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "^14.2.35",
    "nodemailer": "^8.0.2",
    "prisma": "^7.10.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.7.0",
    "shadcn": "^4.19.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
